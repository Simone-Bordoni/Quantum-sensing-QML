## Usage Examples

### Example 1: Single Qubit Sensing (Simplest Case)

```python
import numpy as np
from qsopt.core import (
    ExperimentalParameters, PhysicalConstants, SystemDimensions,
    NoiseConfiguration, MeasurementProtocol, InitialStateConfig,
    InitialStateType
)
from qsopt.core.experiment import Experiment
from qsopt.core.circuit import create_ry_circuit

# Define physical system (single qubit: n_qubits=1)
physical_constants = PhysicalConstants(
    n_qubits=1,  # Specify number of qubits
    chi=0.5 * 0.03 * 2 * np.pi,  # Dispersive coupling
    photon_cavity_coupling=0.03 * 2 * np.pi,
    inverse_pulse_width=0.1 * 0.03 * 2 * np.pi
)

system_dims = SystemDimensions(
    cavity_levels=2, qubit_levels=2, field_levels=2
)

# Configure measurement and noise
measurement = MeasurementProtocol(measurement_times=[-5.0, 0.0, 5.0])
noise_config = NoiseConfiguration(
    relaxation=0.0001 * 2 * np.pi,
    dephasing=0.0001 * 2 * np.pi
)
initial_state = InitialStateConfig(state_type=InitialStateType.SINGLE_PHOTON)

# Create experimental parameters
exp_params = ExperimentalParameters(
    physical_constants=physical_constants,
    system_dims=system_dims,
    measurement=measurement,
    initial_state=initial_state,
    noise_config=noise_config
)

# Define circuits (or use None for default RY circuits)
initial_circuit = create_ry_circuit(n_qubits=1, theta_values=[np.pi / 2])
final_circuit = create_ry_circuit(n_qubits=1, theta_values=[-np.pi / 2])

# Create experiment (unified interface for any n-qubit system)
experiment = Experiment(
    experimental_params=exp_params,
    initial_circuit=initial_circuit,
    final_circuit=final_circuit
)

# Run single simulation
callback = experiment.run_simulation(batch_size=1)
print(f"Detection probability with photon: {callback.history['prob_with'][-1]:.6f}")
print(f"Sensing contrast: {callback.history['contrast'][-1]:.6f}")

# Optimize circuit parameters
callback = experiment.optimize_rotations(num_steps=100, verbose=True)
print(f"\nFinal optimized contrast: {callback.best_metrics['contrast']:.6f}")
```

### Example 2: Two-Qubit Sensing with Custom Circuits

```python
from qsopt.core.circuit import QuantumCircuit
from qsopt.core.gates import RYGate, CNOTGate

# Define custom 2-qubit circuit with entanglement
initial_circuit = QuantumCircuit(n_qubits=2)

# Qubit 0: RY gate with trainable parameter
initial_circuit.add_gate(RYGate(theta=np.pi / 4, target=0, trainable=True))

# Qubit 1: RY gate with trainable parameter
initial_circuit.add_gate(RYGate(theta=np.pi / 3, target=1, trainable=True))

# Add CNOT for entanglement (control qubit 0, target qubit 1)
initial_circuit.add_gate(CNOTGate(target=(0, 1)))

# Create final circuit similarly
final_circuit = QuantumCircuit(n_qubits=2)
final_circuit.add_gate(RYGate(theta=-np.pi / 4, target=0, trainable=True))
final_circuit.add_gate(RYGate(theta=-np.pi / 3, target=1, trainable=True))

# Update physical constants for 2 qubits
physical_constants = PhysicalConstants(
    n_qubits=2,
    chi=[0.5 * 0.03 * 2 * np.pi, 0.4 * 0.03 * 2 * np.pi],  # Different χ per qubit
    photon_cavity_coupling=0.03 * 2 * np.pi,
    inverse_pulse_width=0.1 * 0.03 * 2 * np.pi
)

# ... (rest of parameters similar to Example 1) ...

# Create and optimize 2-qubit experiment
experiment = Experiment(exp_params, initial_circuit, final_circuit)
callback = experiment.optimize_rotations(num_steps=100)
```

### Example 3: Building Complex Quantum Circuits

```python
import jax.numpy as jnp
from qsopt.core.circuit import QuantumCircuit
from qsopt.core.gates import RXGate, RYGate, CNOTGate, HadamardGate

# Create a 2-qubit parameterized quantum circuit
circuit = QuantumCircuit(n_qubits=2)

# Add gates with target qubit in the constructor
circuit.add_gate(HadamardGate(target=0))
circuit.add_gate(RXGate(theta=jnp.pi / 4, target=1, trainable=True))
circuit.add_gate(CNOTGate(target=(0, 1)))
circuit.add_gate(RYGate(theta=jnp.pi / 2, target=0, trainable=True))

# Get circuit unitary as JAX array (ready for autodiff)
U = circuit.get_unitary(qutip=False)
print(f"Unitary shape: {U.shape}, dtype: {U.dtype}")

# Get circuit unitary as QuTiP Qobj
U_qt = circuit.get_unitary(qutip=True)

# Access trainable parameters (list of JAX arrays)
params = circuit.get_trainable_parameters()
print(f"Trainable parameters: {params}")

# Update parameters from optimizer output (list of JAX arrays)
import jax.numpy as jnp
circuit.set_trainable_parameters([jnp.array(jnp.pi / 2), jnp.array(jnp.pi)])
print(circuit)  # prints circuit summary with gate list
```

### Example 4: Layered Circuit Construction

```python
import numpy as np
from qsopt.core.circuit import QuantumCircuit
from qsopt.core.gates import RYGate, CNOTGate

# Build a 3-qubit ansatz circuit using add_layer and add_entangling_layer
circuit = QuantumCircuit(n_qubits=3)

# First rotation layer: RY on all 3 qubits
circuit.add_layer(RYGate, parameters=[np.pi / 4, np.pi / 3, np.pi / 6], trainable=True)

# Entangling layer: CNOT(0,1), CNOT(1,2)
circuit.add_entangling_layer(CNOTGate, pattern="linear")

# Second rotation layer
circuit.add_layer(RYGate, trainable=True)  # defaults to π/2 per qubit

# Inspect circuit
print(circuit)
print(f"Trainable parameters: {circuit.count_trainable_parameters()}")

# Get unitary for simulation
U = circuit.get_unitary(qutip=True)   # QuTiP Qobj for experiment
U_jax = circuit.get_unitary(qutip=False)  # JAX array for autodiff
```

For complete examples, see the [examples/](./examples/) directory.

## Project Structure

```
Quantum-sensing-QML/
├── src/qsopt/                          # Main library package
│   ├── __init__.py                     # Public API exports
│   ├── core/                           # Core quantum objects
│   │   ├── gates.py                    # JAX-compatible quantum gates (RX,RY,RZ,H,CNOT,CZ)
│   │   ├── circuit.py                  # QuantumCircuit builder with trainable parameters
│   │   ├── experimental_parameters.py  # System configuration dataclasses
│   │   ├── loss_functions.py           # DetectionMetric and optimization objectives
│   │   ├── callback.py                 # OptimizationCallback for tracking progress
│   │   └── experiment/
│   │       ├── experiment.py           # Unified Experiment class (n-qubit)
│   │       └── quantum_utils.py        # Hamiltonian construction utilities
│   ├── utils/                          # Utility modules
│   │   ├── results.py                  # TimeEvolutionResults / SweepResults containers
│   │   ├── visualization.py            # Plotting (contrast, dashboard, trajectory)
│   │   ├── landscape_analysis.py       # Parameter landscape sweep tools
│   │   └── experiment_loader.py        # Experiment serialization utilities
│   └── tests/                          # Test suite (16 files, 301 tests, 0 failures)
├── experiments/                        # Research experiment scripts
│   ├── single_qubit/                   # 1-qubit optimization experiments
│   └── two_qubits/                     # 2-qubit optimization experiments
├── examples/                           # Jupyter notebook tutorials
│   ├── single_qubit_tutorial.ipynb
│   ├── two_qubit_tutorial.ipynb
│   ├── three_qubit_tutorial.ipynb
│   ├── sweep_experiments_tutorial.ipynb
│   └── circuit_tutorial.ipynb
├── docs/                               # Documentation
├── pyproject.toml                      # Package metadata and pinned dependencies
├── requirements.txt                    # Core runtime dependencies (pinned)
├── requirements-dev.txt                # Dev/test dependencies (pinned)
└── .pylintrc                           # Pylint configuration
```

